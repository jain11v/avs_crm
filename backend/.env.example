# This app reads .env.development / .env.test / .env.production, chosen by
# the APP_ENV variable set in each npm script (see package.json — `npm run
# dev` / `dev:test` / `dev:prod`, `migrate` / `migrate:test` / `migrate:prod`,
# etc.). Copy this file to each of the three and fill in real values; a
# plain .env still works too, as a fallback when the APP_ENV-specific file
# is missing. Never commit any of them — all covered by .gitignore's
# `.env*` rule already.
#
# APP_ENV only selects which file loads (i.e. which database you're
# pointed at) — it's deliberately separate from NODE_ENV below, which
# keeps its normal meaning (HTTPS-only auth cookie in real deployments).
# All three environments currently run locally over plain http, so
# NODE_ENV stays 'development' in all three files below until this app is
# actually deployed somewhere with HTTPS.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
# Migrations change the schema, so they use a separate, more powerful login
# (the postgres superuser). The app itself uses DB_USER above, which can only
# read/write data. Leave these out to migrate with DB_USER.
MIGRATE_DB_USER=postgres
MIGRATE_DB_PASSWORD=
# Optional — defaults shown. DB_SSL=true only when the database is on another host.
# DB_SSL=false
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Auth ---
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Frontend origin (for CORS) ---
FRONTEND_URL=http://localhost:5173
